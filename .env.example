# Admin girisi
ADMIN_KULLANICI=omuroz
# Sifrenin bcrypt hash'i, base64 kodlu. Uretmek icin:
#   npm run hash -- 'sifreniz'
ADMIN_PASSWORD_HASH_B64=

# jose imzalama anahtari, en az 32 karakter. Uretmek icin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# SQLite dosyasi (Docker'da named volume'a bakar)
DB_PATH=./data/nisan.db
# Yuklenen sahne gorselleri (Docker'da nisan-medya volume'u)
MEDYA_KOK=./medya/scenes
